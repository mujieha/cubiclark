#!/bin/sh
# A stand-in for the claude executable. Tests must never run the real one: `--version` prints a
# version, and `agents --json` prints test/fixtures/bin/agents.json, the shape documented for
# `claude agents --json` (invented sessions).
if [ "$1" = "agents" ]; then
  cat "$(dirname "$0")/agents.json"
  exit 0
fi
echo "2.1.285 (Claude Code)"
