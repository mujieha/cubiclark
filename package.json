{
  "name": "cubiclark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local view of live Claude Code agents and their states.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mujieha/cubiclark.git"
  },
  "homepage": "https://github.com/mujieha/cubiclark#readme",
  "bugs": {
    "url": "https://github.com/mujieha/cubiclark/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "cubiclark": "dist/bin.js"
  },
  "files": [
    "dist",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json && vite build",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "fixtures:check": "tsx scripts/make-fixtures.ts --check",
    "width-table": "tsx scripts/make-east-asian-width.ts",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:firefox": "npm run build && playwright test --config playwright.firefox.config.ts",
    "test:hooks": "npm run build && vitest run --config vitest.hooks.config.ts",
    "bench:hook": "npm run build && tsx scripts/bench-hook.ts",
    "start": "node dist/bin.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
