{
  "name": "cubiclark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local view of live Claude Code agents and their states.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "cubiclark": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json && vite build",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "fixtures:check": "tsx scripts/make-fixtures.ts --check",
    "test:e2e": "npm run build && playwright test",
    "start": "node dist/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
